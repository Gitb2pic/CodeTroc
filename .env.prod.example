# Copier en .env sur le VPS (cp .env.prod.example .env && chmod 600 .env), puis compléter.
DOMAIN=codetroc.labtools.tech
ACME_EMAIL=
GITHUB_CLIENT_ID=
GITHUB_APP_ID=

# Email (F18, facultatif) : sans SMTP_HOST, l'inscription par email est fermée
# et seule la connexion GitHub est proposée. Port 465 = TLS direct, sinon STARTTLS obligatoire.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=CodeTroc <no-reply@codetroc.labtools.tech>
